{:paths ["src"]

 :jolt/min-version "0.8.6"

 :deps {io.github.casselc/otel
        {:git/url "https://github.com/casselc/otel.git"
         :git/sha "88a63fd90e0969635dda75fbb9fe5ba2264c09d8"}
        io.github.casselc/jolt-http
        {:git/url "https://github.com/casselc/jolt-http.git"
         :git/sha "35d1d7f9ebdc796ee9bd4c80745298b2c8b7fdf8"}
        io.github.chucklehead-dev/jolt-chdb
        {:git/url "https://github.com/chucklehead-dev/jolt-chdb.git"
         :git/sha "19e0ecf9e9f5e2c3f24ac8758f5d6953fd021774"}
        io.github.chucklehead-dev/jolt-otel-clickhouse
        {:git/url "https://github.com/chucklehead-dev/jolt-otel-clickhouse.git"
         :git/sha "0f8bf3de8c225ed4ab4f700fe60bb7c85229136d"}
        io.github.chucklehead-dev/jolt-otel-viewer
        {:git/url "https://github.com/chucklehead-dev/jolt-otel-viewer.git"
         :git/sha "5723a7c28c3bb3ae7cb27f9856b90463e77df523"}
        metosin/malli {:mvn/version "0.20.1"}
        org.clojure/data.json
        {:git/url "https://github.com/casselc/data.json.git"
         :git/sha "932444043c0c06f9e295ba4963419b2481e9dd07"}}

 :aliases
 {:test-embedded-profile
  {:extra-paths ["test"]
   :main-opts ["-m" "oscope.embedded-profile-test-runner"]}

  :test-config
  {:extra-paths ["test"]
   :main-opts ["-m" "oscope.config-test-runner"]}

  :test-managed-config-worker
  {:extra-paths ["test"]
   :main-opts ["-m" "oscope.managed-config-worker"]}

  :test-managed-config-load-worker
  {:extra-paths ["test"]
   :main-opts ["-m" "oscope.managed-config-load-worker"]}

  :test-headless
  {:extra-paths ["test"]
   :extra-deps
   {io.github.chucklehead-dev/jolt-hegel
    {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
     :git/sha "b214f769983211431c74e427f0f35553cfba7b34"}}
   :main-opts ["-m" "oscope.headless-test-runner"]}

  :test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.chucklehead-dev/jolt-hegel
    {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
     :git/sha "b214f769983211431c74e427f0f35553cfba7b34"}
    io.github.casselc/glitter
    {:git/url "https://github.com/casselc/glitter.git"
     :git/sha "f4e3eb83015566e4cadaedd7f5e8ad80dc57404f"}
    io.github.casselc/glimmer
    {:git/url "https://github.com/casselc/glimmer.git"
     :git/sha "6dab5597dc0d912793fe175d0d3cbb9e75f11426"}}
   :main-opts ["-m" "oscope.test-runner"]}

  :test-chdb
  {:extra-paths ["test"]
   :extra-deps
   {io.github.casselc/glitter
    {:git/url "https://github.com/casselc/glitter.git"
     :git/sha "f4e3eb83015566e4cadaedd7f5e8ad80dc57404f"}}
   :main-opts ["-m" "oscope.chdb-test-runner"]}

  :test-typed-socket
  {:extra-paths ["test"]
   :main-opts ["-m" "oscope.typed-socket-test-runner"]}

  :test-typed-log-filter
  {:extra-paths ["test"]
   :main-opts ["-m" "oscope.typed-log-filter-test-runner"]}

  :test-langfuse
  {:extra-paths ["test"]
   :main-opts ["-m" "oscope.langfuse-interop"]}

  :test-readers
  {:extra-paths ["test"]
   :main-opts ["-m" "oscope.reader-test-runner"]}

  :test-durable
  {:extra-paths ["test"]
   ;; Qualification must have one physical time provider under both library
   ;; identities. This alias does not alter ordinary production dependencies.
   :override-deps
   {jolt-lang/time
    {:git/url "https://github.com/chucklehead-dev/time.git"
     :git/sha "2494b21b25cd959573c3e6050cd475e4bf302fdb"}
    io.github.jolt-lang/time
    {:git/url "https://github.com/chucklehead-dev/time.git"
     :git/sha "2494b21b25cd959573c3e6050cd475e4bf302fdb"}}
   :extra-deps
   {io.github.chucklehead-dev/jolt-aspect-packs
    {:git/url "https://github.com/chucklehead-dev/jolt-aspect-packs.git"
     :git/sha "3773a67801bdcbd63c6484f95fa07a4b8afddb72"}}
   :main-opts ["-m" "oscope.durable-test-runner"]}

  :test-durable-dev
  {:override-deps
   {io.github.chucklehead-dev/jolt-chdb
    {:local/root "../jolt-chdb"}
    io.github.chucklehead-dev/jolt-otel-clickhouse
    {:local/root "../jolt-otel-clickhouse"}}
   :extra-paths ["test"]
   :extra-deps
   {io.github.chucklehead-dev/jolt-aspect-packs
    {:git/url "https://github.com/chucklehead-dev/jolt-aspect-packs.git"
     :git/sha "3773a67801bdcbd63c6484f95fa07a4b8afddb72"}}
   :main-opts ["-m" "oscope.durable-test-runner"]}

  :durable-server-dev
  {:override-deps
   {io.github.chucklehead-dev/jolt-chdb
    {:local/root "../jolt-chdb"}
    io.github.chucklehead-dev/jolt-otel-clickhouse
    {:local/root "../jolt-otel-clickhouse"}}
   :main-opts ["-m" "oscope.durable-server-main"]}

  :durable-crash-verify-dev
  {:override-deps
   {io.github.chucklehead-dev/jolt-chdb
    {:local/root "../jolt-chdb"}
    io.github.chucklehead-dev/jolt-otel-clickhouse
    {:local/root "../jolt-otel-clickhouse"}}
   :extra-paths ["test"]
   :main-opts ["-m" "oscope.durable-crash-verify"]}

  :test-durable-s3-dev
  {:override-deps
   {io.github.chucklehead-dev/jolt-chdb
    {:local/root "../jolt-chdb"}
    io.github.chucklehead-dev/jolt-otel-clickhouse
    {:local/root "../jolt-otel-clickhouse"}}
   :extra-paths ["test"]
   :main-opts ["-m" "oscope.durable-s3-test-runner"]}

  :test-durable-s3
  {:extra-paths ["test"]
   :main-opts ["-m" "oscope.durable-s3-test-runner"]}

  :test-typed-query-storage-report
  {:extra-paths ["benchmark" "test"]
   :main-opts ["-m" "oscope.typed-query-storage-report-test-runner"]}

  :bench-typed-query-storage
  {:extra-paths ["benchmark"]
   :main-opts ["-m" "oscope.typed-query-storage"]}

  :web-snapshot {:main-opts ["-m" "oscope.ui.web"]}
  :server {:main-opts ["-m" "oscope.server-main"]}
  :typed-browser-server
  {:extra-paths ["test"]
   :main-opts ["-m" "oscope.typed-browser-server-main"]}

  :typed-log-browser-server
  {:extra-paths ["test"]
   :main-opts ["-m" "oscope.typed-log-browser-server-main"]}
  :emit-sample {:main-opts ["-m" "oscope.sample-emitter"]}
  :live-web {:main-opts ["-m" "oscope.live-main" "web"]}

  :native
  {:extra-deps
   {io.github.casselc/glitter
    {:git/url "https://github.com/casselc/glitter.git"
     :git/sha "f4e3eb83015566e4cadaedd7f5e8ad80dc57404f"}}
   :main-opts ["-m" "oscope.ui.native"]}

  :live-native
  {:extra-deps
   {io.github.casselc/glitter
    {:git/url "https://github.com/casselc/glitter.git"
     :git/sha "f4e3eb83015566e4cadaedd7f5e8ad80dc57404f"}}
   :main-opts ["-m" "oscope.live-main" "native"]}

  :native-server
  {:extra-deps
   {io.github.casselc/glitter
    {:git/url "https://github.com/casselc/glitter.git"
     :git/sha "f4e3eb83015566e4cadaedd7f5e8ad80dc57404f"}}
   :main-opts ["-m" "oscope.native-server-main"]}

  :glimmer-native
  {:extra-deps
   {io.github.casselc/glimmer
    {:git/url "https://github.com/casselc/glimmer.git"
     :git/sha "6dab5597dc0d912793fe175d0d3cbb9e75f11426"}
    io.github.jolt-lang/glimmer-gtk
    {:git/url "https://github.com/jolt-lang/glimmer-gtk.git"
     :git/sha "ce79d45698d36ccf496397bb85974e3cce6abfd8"}}
   :main-opts ["-m" "oscope.ui.glimmer-native"]}

  :live-glimmer-native
  {:extra-deps
   {io.github.casselc/glimmer
    {:git/url "https://github.com/casselc/glimmer.git"
     :git/sha "6dab5597dc0d912793fe175d0d3cbb9e75f11426"}
    io.github.jolt-lang/glimmer-gtk
    {:git/url "https://github.com/jolt-lang/glimmer-gtk.git"
     :git/sha "ce79d45698d36ccf496397bb85974e3cce6abfd8"}}
   :main-opts ["-m" "oscope.live-main" "glimmer-native"]}

  ;; JVM-only, dev-only Typed Clojure pilot. Ordinary Jolt/runtime aliases do
  ;; not resolve the checker or add these paths.
  :typed-check
  {:replace-paths ["src" "script" "typed"]
   :replace-deps
   {org.clojure/clojure {:mvn/version "1.12.5"}
    org.typedclojure/typed.clj.checker {:mvn/version "1.3.0"}}
   :main-opts ["-m" "oscope.typed-check"]}}

 :tasks {test "jolt -M:test"
         test-embedded-profile "jolt -M:test-embedded-profile"
         test-config "jolt -M:test-config"
         test-headless "jolt -M:test-headless"
         test-chdb "jolt -M:test-chdb"
         test-typed-socket "jolt -M:test-typed-socket"
         test-langfuse "test/langfuse_interop.sh"
         test-langfuse-env "test/langfuse_interop_env_test.sh"
         test-langfuse-workflow "test/langfuse_workflow_test.sh"
         test-readers "jolt -M:test-readers"
         test-durable "jolt -M:test-durable"
         test-durable-dev "jolt -M:test-durable-dev"
         test-durable-aspect "test/durable_aspect_smoke.sh"
         test-durable-fault "test/durable_fault_acceptance.sh"
         test-durable-s3-aspect "test/durable_s3_aspect_smoke.sh"
         test-durable-crash "test/durable_crash_reopen.sh"
         test-durable-s3-crash "test/durable_s3_crash_reopen.sh"
         test-durable-s3 "test/durable_s3_minio.sh"
         test-typed-query-storage-report
         "jolt -M:test-typed-query-storage-report"
         bench-typed-query-storage
         "scripts/run-typed-query-storage-benchmark.sh"
         durable-server-dev "jolt -M:durable-server-dev"
         test-standalone "test/standalone_build_smoke.sh"
         web-snapshot "jolt -M:web-snapshot"
         server "jolt -M:server"
         emit-sample "jolt -M:emit-sample"
         live-web "jolt -M:live-web"
         native "jolt -M:native"
         live-native "jolt -M:live-native"
         native-server "jolt -M:native-server"
         glimmer-native "jolt -M:glimmer-native"
         live-glimmer-native "jolt -M:live-glimmer-native"}}
