{:paths ["src"]
 :jolt/min-version "0.8.6"
 :deps {io.github.chucklehead-dev/oscope-embedded
        {:local/root "../../../profiles/embedded"}
        ;; Model the authoritative application's completed provider migration:
        ;; the canonical key selects merged casselc/db while the embedded
        ;; profile's transitive jolt-chDB dependency uses the same key.
        jolt-lang/db
        {:git/url "https://github.com/casselc/db.git"
         :git/sha "8c55d9e273f7d625b5c0eb8000755c51a8faacfe"}
        ;; Preserve the application's interruptible HTTP contract under the
        ;; same canonical key used by Samizdat after its provider migration.
        jolt-lang/http-client
        {:git/url "https://github.com/casselc/http-client.git"
         :git/sha "eab6b78d5957f88690faf6768360572a3f185341"}
        ;; The application owns its final graph: do not let its database's
        ;; transitive JSON revision override the embedded profile's selection.
        org.clojure/data.json
        {:git/url "https://github.com/casselc/data.json.git"
         :git/sha "97298fd8a67a6d4ee3eb1346d5e184beb9565b90"}}
 :aliases {:test {:main-opts ["-m" "minimal-embedded-app"]}}}
